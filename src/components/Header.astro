---
import { withBase } from '../utils/withBase';
import BrandWordmark from './BrandWordmark.astro';
---

<header class="site-header" id="site-navigation" data-header>
  <a class="brand" href="#inicio" aria-label="MORA, volver al inicio"><BrandWordmark /></a>

  <nav class="desktop-nav" aria-label="Navegación principal">
    <a href="#tattoos">Tattoos</a>
    <a href="#pasteleria">Pastelería</a>
    <a href="#sofit">Sofit</a>
    <a href={withBase('sobre-mora')}>Sobre</a>
    <a class="nav-contact" href={withBase('contacto')}>Contacto</a>
  </nav>

  <details class="mobile-menu">
    <summary><span>Menú</span><i aria-hidden="true"></i></summary>
    <nav aria-label="Navegación móvil">
      <a href="#tattoos">01 Tattoos</a>
      <a href="#pasteleria">02 Pastelería</a>
      <a href="#sofit">03 Sofit</a>
      <a href={withBase('sobre-mora')}>Sobre Mora</a>
      <a href={withBase('contacto')}>Contacto</a>
    </nav>
  </details>
</header>

<button
  class="header-dock"
  type="button"
  aria-label="Mostrar navegación"
  aria-controls="site-navigation"
  aria-expanded="false"
  aria-hidden="true"
  tabindex="-1"
  data-header-dock
>
  <BrandWordmark />
  <span class="header-dock-label">Menú</span>
</button>
