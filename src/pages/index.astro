---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TattooAct from '../components/TattooAct.astro';
import MatterTransition from '../components/MatterTransition.astro';
import PastryAct from '../components/PastryAct.astro';
import PastryToSofitTransition from '../components/PastryToSofitTransition.astro';
import SofitAct from '../components/SofitAct.astro';
import MoraSignature from '../components/MoraSignature.astro';
import ContactIntent from '../components/ContactIntent.astro';
import Footer from '../components/Footer.astro';
import WhatsAppLink from '../components/WhatsAppLink.astro';
---

<BaseLayout
  title="MORA — Expresión en todas sus formas"
  description="MORA: Tattoos, Pastelería y Sofit. Expresión en la piel, en los sabores y en el movimiento."
>
  <Header />
  <main id="contenido">
    <Hero />
    <TattooAct />
    <MatterTransition />
    <PastryAct />
    <PastryToSofitTransition />
    <SofitAct />
    <MoraSignature />
    <ContactIntent />
  </main>
  <Footer />
  <WhatsAppLink />

  <script>
    import { initHomeMotion } from '../scripts/home-motion';
    initHomeMotion();
  </script>
</BaseLayout>
