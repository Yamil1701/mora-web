---
import '../styles/global.css';
import '../styles/prototype-02.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'MORA — Expresión en todas sus formas.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#11100f" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
